# ========================================================
# PUBLIC / CLOUD ENVIRONMENT CONFIGURATION (.env.public.example)
# Use this configuration when deploying to Vercel, VPS, or Cloud
# AI Provider: Google AI Studio (Gemini)
# ========================================================

# MongoDB Database Connection (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aiChatbot?retryWrites=true&w=majority

# Security Secret for JWT Authentication (generate a secure random string)
JWT_SECRET=generate-a-strong-secret-key-for-production-use

# Public App Name
NEXT_PUBLIC_APP_NAME="GenAI Chatbot Dashboard"

# Active AI Provider: Set to 'gemini' for Public/Cloud deployment
AI_PROVIDER=gemini

# Google AI Studio Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-1.5-flash
