# ========================================================
# PUBLIC / CLOUD ENVIRONMENT CONFIGURATION (.env.public.example)
# Use this when deploying to Vercel, Railway, VPS, etc.
# AI Provider: OpenRouter (Free Cloud Models)
# ========================================================

# MongoDB Database Connection (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aiChatbot?retryWrites=true&w=majority

# Security Secret for JWT Authentication
JWT_SECRET=generate-a-strong-secret-key-for-production-use

# Public App Name & URL
NEXT_PUBLIC_APP_NAME="GenAI Chatbot Dashboard"
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Active AI Provider: Set to 'openrouter' for Public/Cloud deployment
AI_PROVIDER=openrouter

# ========================================================
# OPENROUTER Configuration
# Free API key from: https://openrouter.ai/keys
# Free models available (suffix ':free'):
#   - meta-llama/llama-3.3-70b-instruct:free
#   - meta-llama/llama-3.1-8b-instruct:free
#   - google/gemini-2.0-flash-exp:free
#   - google/gemma-3-27b-it:free
#   - mistralai/mistral-7b-instruct:free
#   - deepseek/deepseek-r1:free
#   - microsoft/phi-4:free
#   - openrouter/auto  (auto-select best free model)
# ========================================================
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
