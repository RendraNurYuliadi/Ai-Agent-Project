# ========================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ========================================================

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/aiChatbot

# Security Secret for JWT Authentication
JWT_SECRET=super-secret-genai-chatbot-token-key-2026

# Public App Name & URL
NEXT_PUBLIC_APP_NAME="GenAI Chatbot Dashboard"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Active AI Provider Selector:
# - 'lmstudio'   : for Local Development using LM Studio
# - 'openrouter' : for Public / Production deployment using OpenRouter
AI_PROVIDER=lmstudio

# ========================================================
# OPTION A: LOCAL ENVIRONMENT (LM Studio)
# ========================================================
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# ========================================================
# OPTION B: PUBLIC / PRODUCTION ENVIRONMENT (OpenRouter)
# Daftar API key gratis di: https://openrouter.ai/keys
# Model gratis ditandai dengan suffix ':free'
# ========================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
